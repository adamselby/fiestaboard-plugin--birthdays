{
  "id": "birthdays",
  "name": "Birthdays",
  "version": "1.0.0",
  "description": "A simple list of names and birthdays. Shows \"It's Adam's birthday!\" on the day, and who's next otherwise.",
  "author": "Adam Selby",
  "repository": "",
  "documentation": "README.md",
  "icon": "cake",
  "category": "utility",
  "supports_triggers": true,
  "min_refresh_seconds": 60,
  "settings_schema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "title": "Enable Birthdays",
        "default": false
      },
      "birthdays": {
        "type": "array",
        "title": "Birthdays",
        "description": "One row per person. Date is MM-DD, or YYYY-MM-DD if you want ages.",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "title": "Name",
              "description": "As it should appear on the board (e.g. Adam)"
            },
            "date": {
              "type": "string",
              "title": "Birthday",
              "description": "MM-DD (e.g. 03-14) or YYYY-MM-DD (e.g. 1986-03-14)"
            }
          },
          "required": [
            "name",
            "date"
          ]
        },
        "default": []
      },
      "timezone": {
        "type": "string",
        "title": "Timezone",
        "description": "Decides when \"today\" starts and ends.",
        "default": "America/Chicago",
        "ui:widget": "timezone"
      },
      "lookahead_days": {
        "type": "integer",
        "title": "Upcoming Window (days)",
        "description": "How far ahead the birthdays.upcoming list looks.",
        "default": 7,
        "minimum": 1,
        "maximum": 366
      },
      "announce": {
        "type": "boolean",
        "title": "Announce on the Board",
        "description": "On someone's birthday, take over the board for a while. Then, return to your normal pages.",
        "default": false
      },
      "announce_hour": {
        "type": "integer",
        "title": "Announcement Start Hour",
        "description": "Hour of the day (0-23, local time) the announcement starts.",
        "default": 8,
        "minimum": 0,
        "maximum": 23
      },
      "announce_minutes": {
        "type": "integer",
        "title": "Announcement Length (minutes)",
        "description": "How long the announcement stays up.",
        "default": 30,
        "minimum": 1,
        "maximum": 1440
      },
      "refresh_seconds": {
        "type": "integer",
        "title": "Refresh Interval (seconds)",
        "description": "How often to recompute. Birthdays change once a day, so this can be long.",
        "default": 300,
        "minimum": 60,
        "maximum": 3600
      }
    }
  },
  "variables": {
    "groups": {
      "today": {
        "label": "Today"
      },
      "next": {
        "label": "Next Birthday"
      }
    },
    "simple": {
      "is_birthday": {
        "description": "\"true\" if anyone's birthday is today, else \"false\"",
        "type": "string",
        "group": "today",
        "max_length": 5,
        "example": "true"
      },
      "message": {
        "description": "Ready-made line, e.g. IT'S ADAM'S BIRTHDAY! (empty when nobody's birthday)",
        "group": "today",
        "max_length": 44,
        "example": "IT'S ADAM'S BIRTHDAY!"
      },
      "names": {
        "description": "Whose birthday it is today, joined with & (empty when nobody's)",
        "group": "today",
        "max_length": 22,
        "example": "ADAM"
      },
      "count": {
        "description": "Number of birthdays today",
        "type": "number",
        "group": "today",
        "max_length": 2,
        "example": "1"
      },
      "age": {
        "description": "Age turned today (first person, only if a birth year was given)",
        "type": "number",
        "group": "today",
        "max_length": 3,
        "example": "40"
      },
      "ordinal": {
        "description": "Age turned today with suffix, e.g. 40TH (only if a birth year was given)",
        "group": "today",
        "max_length": 6,
        "example": "40TH"
      },
      "confetti": {
        "description": "22 random color tiles, reshuffled every refresh. Use LEFT/RIGHT(birthdays.confetti, tiles * 4) for fewer.",
        "group": "today",
        "max_length": 22,
        "example": "{65}{63}{67}{64}{68}{66}"
      },
      "next_name": {
        "description": "Name of the next upcoming birthday (after today)",
        "group": "next",
        "max_length": 22,
        "example": "SAM"
      },
      "next_date": {
        "description": "Date of the next birthday, e.g. NOV 21",
        "group": "next",
        "max_length": 6,
        "example": "NOV 21"
      },
      "next_days": {
        "description": "Days until the next birthday",
        "type": "number",
        "group": "next",
        "max_length": 3,
        "example": "3"
      },
      "next_formatted": {
        "description": "e.g. SAM IN 3 DAYS / SAM TOMORROW",
        "group": "next",
        "max_length": 22,
        "example": "SAM IN 3 DAYS"
      }
    },
    "arrays": {
      "today": {
        "label_field": "name",
        "item_fields": [
          "name",
          "age"
        ]
      },
      "upcoming": {
        "label_field": "name",
        "item_fields": [
          "name",
          "date",
          "days",
          "age"
        ]
      }
    }
  },
  "max_lengths": {
    "today.*.name": 22,
    "today.*.age": 3,
    "upcoming.*.name": 15,
    "upcoming.*.date": 6,
    "upcoming.*.days": 3,
    "upcoming.*.age": 3
  },
  "demo": {
    "name": "Birthdays Demo",
    "device_type": "flagship",
    "template": [
      "",
      "{{= IF(birthdays.is_birthday = \"true\", birthdays.message, \"NEXT BIRTHDAY\") }}",
      "",
      "{{= IF(birthdays.is_birthday = \"true\", \"\", birthdays.next_formatted) }}",
      "",
      ""
    ],
    "line_metadata": [
      {
        "alignment": "center",
        "wrap": false
      },
      {
        "alignment": "center",
        "wrap": false
      },
      {
        "alignment": "center",
        "wrap": false
      },
      {
        "alignment": "center",
        "wrap": false
      },
      {
        "alignment": "center",
        "wrap": false
      },
      {
        "alignment": "center",
        "wrap": false
      }
    ]
  },
  "teaser": "HAPPY BDAY ADAM",
  "previews": [
    {
      "device_type": "flagship",
      "rows": [
        "{63}{64}{65}{66}{67}{68}{63}{64}{65}{66}{67}{68}{63}{64}{65}{66}{67}{68}{63}{64}{65}{66}",
        "                      ",
        "     IT'S ADAM'S      ",
        "      BIRTHDAY!       ",
        "                      ",
        "{66}{67}{68}{63}{64}{65}{66}{67}{68}{63}{64}{65}{66}{67}{68}{63}{64}{65}{66}{67}{68}{63}"
      ]
    },
    {
      "device_type": "note",
      "rows": [
        "{63}{64}{65}{66}{67}{68}{63}{64}{65}{66}{67}{68}{63}{64}{65}",
        "  IT'S ADAM'S  ",
        "   BIRTHDAY!   "
      ]
    }
  ]
}
